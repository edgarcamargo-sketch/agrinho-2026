/* Definição de Variáveis de Cores (Paleta Sustentável) */
:root {
    --verde-principal: #2e7d32;
    --verde-claro: #4caf50;
    --castanho: #795548;
    --fundo-claro: #f1f8e9;
    --texto-escuro: #212121;
    --branco: #ffffff;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: var(--fundo-claro);
    color: var(--texto-escuro);
    line-height: 1.6;
}

/* Layout Header com Flexbox */
header {
    background-color: var(--verde-principal);
    color: var(--branco);
    padding: 1rem 2rem;
}

.header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
}

/* Conteúdo Principal */
main {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
}

section {
    background: var(--branco);
    padding: 2rem;
    margin-bottom: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
}

/* Estilização do Formulário */
.form-group {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
}

label {
    font-weight: bold;
    margin-bottom: 0.3rem;
}

small {
    color: #666;
    margin-bottom: 0.5rem;
}

input {
    padding: 0.75rem;
    border: 2px solid #ccc;
    border-radius: 4px;
    font-size: 1rem;
    transition: border-color 0.3s;
}

input:focus {
    border-color: var(--verde-claro);
    outline: none;
}

button {
    background-color: var(--verde-principal);
    color: var(--branco);
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    cursor: pointer;
    width: 100%;
    transition: background 0.3s;
}

button:hover {
    background-color: var(--verde-claro);
}

/* Classes Auxiliares e Estado Dinâmico */
.hidden {
    display: none;
}

.alert-box {
    background-color: #e8f5e9;
    padding: 1rem;
    border-left: 5px solid var(--verde-claro);
    margin-bottom: 1rem;
    font-weight: bold;
}

.dica-box {
    margin-top: 1rem;
    padding: 1rem;
    background-color: #efebe9;
    border-left: 5px solid var(--castanho);
}

/* --- MEDIA QUERIES (Responsividade de Desktop cobrada no Nível 4) --- */
@media (min-width: 768px) {
    #form-compostagem {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }
    
    #form-compostagem h3, 
    #form-compostagem button {
        grid-column: span 2;
    }
}